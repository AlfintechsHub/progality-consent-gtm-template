___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const setDefaultConsentState = require('setDefaultConsentState');
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

// "No consent yet" for every tag, through Tag Manager's own consent API, before any other tag runs.
setDefaultConsentState({"analytics_storage":"denied","ad_storage":"denied","ad_user_data":"denied","ad_personalization":"denied","functionality_storage":"denied","personalization_storage":"denied","security_storage":"granted","wait_for_update":500});

// The banner then sends the visitor's real choice as an update.
const url = "https://consent-cdn.progality.com/progality-consent-runtime.js?site=" + encodeUriComponent(data.siteId);
injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, url);


